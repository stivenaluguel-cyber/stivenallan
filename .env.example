# ── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://stivenallan.com.br

# ── Mensuração (client, públicas) ──────────────────────────────────────
# IDs têm fallback hardcoded em src/lib/tracking-config.ts pra produção não
# quebrar sem env — mas o certo é declará-las na Vercel.
NEXT_PUBLIC_GA4_ID=G-5TWF0JTG8H
NEXT_PUBLIC_META_PIXEL_ID=364836344657445
# Google Ads (só quando a conta existir; sem elas, nada do Ads carrega/dispara)
NEXT_PUBLIC_GADS_ID=
NEXT_PUBLIC_GADS_CONVERSION=

# ── Meta Conversions API (server, secretas) ────────────────────────────
# Gerenciador de Eventos → pixel → Configurações → Gerar token de acesso
META_CAPI_TOKEN=
# Opcional, SÓ durante validação: código da aba "Testar eventos" do
# Gerenciador de Eventos (ex.: TEST12345). Remover depois de validar.
META_TEST_EVENT_CODE=

# ── Webhooks de leads de anúncios (Meta Ads / Google Ads / Instagram DM → Kanban) ─
# Direção OPOSTA à do bloco acima: aqui é o Meta/Google mandando leads NOVOS
# pra dentro do CRM, não o CRM mandando eventos pra fora.
# As 3 primeiras variáveis abaixo servem tanto pro webhook de Lead Ads
# (/api/webhook/meta-leads, campo "leadgen") quanto pro de DM do Instagram
# (/api/webhook/instagram, campo "messages") — mesmo App, mesmo token.
# Meta for Developers → seu App → Webhooks → Page → assinar campo "leadgen"
META_WEBHOOK_VERIFY_TOKEN=
# Meta for Developers → seu App → Configurações básicas → Chave secreta do app
META_APP_SECRET=
# Gerenciador de Eventos/Business → Página → gerar token de acesso de página
# com a permissão leads_retrieval
META_PAGE_ACCESS_TOKEN=
# Google Ads → Ferramentas → Ativos de leads → Configurações do webhook
# (você mesmo gera essa string e cola nos dois lugares)
GOOGLE_LEADS_WEBHOOK_KEY=

# ── Notificação push (novo lead → notificação real no app instalado) ──
# Gerado uma única vez com `web-push.generateVAPIDKeys()` — não precisa
# regerar depois. A pública vai pro client (NEXT_PUBLIC_), a privada nunca
# sai do servidor.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Supabase ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── E-mail (Resend) ────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM="Stiven Allan <contato@stivenallan.com.br>"

# ── Segurança / tokens ─────────────────────────────────────────────────
UNSUBSCRIBE_SECRET=
JWT_SECRET=

# ── Sentry (DSN não é segredo) ─────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Cadastro único / liberação progressiva de conteúdo (lead gate) ──────
# Server-only (NUNCA NEXT_PUBLIC_*) — a lista de slugs habilitados não pode
# vazar no bundle público. Nenhuma das duas fica "true" automaticamente em
# produção; ativação é manual, slug a slug, sem precisar de novo deploy.
# LEAD_GATE_ENABLED=false
# LEAD_GATE_SLUGS=
# LEAD_PROPERTY_HISTORY_ENABLED=false
